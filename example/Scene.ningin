#Title("A Scene")
@test2{
    Transform{
        Position(100.0,100.0,0.0)
        Rotation(0.0,0.0,0.0)
        Scale(1.0,1.0,1.0)
   }
   
   Text{
       TextColor(255, 255, 100, 255)
       FontName("arial.ttf")
       FontSize(70)
       Text("Use WaSD To Move \n Use \"Enter\" To Play audio")
       Shader("text")
       UseMultiLine(true)
   }
}

@potato{
    <example "FPS">
    Transform {
        Position(1000.0,0.0,0.0)
        Rotation(0.0,0.0,0.0)
        Scale(1.0,1.0,1.0)
    }

    Text{
       TextColor(255, 255, 100, 255)
       FontName("arial.ttf")
       FontSize(70)
       Text("[FPS] : 0")
       Shader("text")
       UseMultiLine(false)
   }
}

@test{
    <example "Class1"> 
    Transform{
        Position(0.0,0.0,0.0)
        Rotation(0.0,0.0,0.0)
        Scale(1.0,1.0,1.0)
   }
   
   Text{
       TextColor(255, 255, 100, 255)
       FontName("arial.ttf")
       FontSize(70)
       Text("Hello")
       Shader("text")
       UseMultiLine(true)
   }
}

