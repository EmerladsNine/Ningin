@sample1{
    <example "Class1"> 
    Transform{
        Position(0.0,0.0,0.0)
        Rotation(0.0,0.0,0.0)
        Scale(1.0,1.0,1.0)
    }
   
    Text{
        TextColor(255, 255, 100, 255)
        FontName("arial.ttf")
        FontSize(70)
        Text("Hello")
        Shader("text")
        UseMultiLine(true)
    }
}
