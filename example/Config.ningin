!Sprite:1{
    Alpha(Bool)
    UseTint(Bool)
    TintingColor(U8, U8, U8, U8)
    TextureName(String)
    Shader(String)
}

!Text:2{
    TextColor(U8, U8, U8, U8)
    FontName(String)
    FontSize(U8)
    Text(String)
    Shader(String)
}

// Types ranges from I64 to I8 , U64 to U8 , F64 and F32
